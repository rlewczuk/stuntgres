#!/usr/bin/env python3
"""Count tracked working-tree source lines without modifying the repository.

Importable with importlib.machinery.SourceFileLoader despite having no .py suffix.
"""

import argparse
import io
import os
from pathlib import Path
import re
import subprocess
import sys
import tokenize


# Match literals before comments, so comment delimiters inside strings survive.
_C_TOKENS = r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|//[^\n]*|/\*[\s\S]*?\*/'
_GO_TOKENS = re.compile(r'`[^`]*`|' + _C_TOKENS)
_C_TOKENS = re.compile(_C_TOKENS)
_HASH_TOKENS = re.compile(r'"(?:\\.|[^"\\])*"|\'[^\']*\'|\\[^\n]|#[^\n]*')
_LANGUAGES = {".go": "go", ".c": "c", ".h": "c", ".y": "c",
              ".py": "python", ".sh": "hash"}


def count_lines(source, language):
    """Return physical lines and lines with non-whitespace outside comments.

    Literals (including Python docstrings) are code. A final unterminated line
    counts; empty files have zero lines. Counting is lexical, not preprocessing.
    """
    total = source.count("\n") + bool(source and not source.endswith("\n"))
    if language == "python":
        lines = source.splitlines(keepends=True)
        for token in tokenize.generate_tokens(io.StringIO(source).readline):
            if token.type == tokenize.COMMENT:
                row, start = token.start
                _, end = token.end
                lines[row - 1] = lines[row - 1][:start] + lines[row - 1][end:]
        stripped = "".join(lines)
    else:
        tokens = {"go": _GO_TOKENS, "c": _C_TOKENS, "hash": _HASH_TOKENS}[language]
        def strip_comment(match):
            text = match.group()
            comment = text.startswith("#") if language == "hash" else text.startswith(("//", "/*"))
            return "\n" * text.count("\n") if comment else text
        stripped = tokens.sub(strip_comment, source)
    return total, sum(bool(line.strip()) for line in stripped.split("\n"))


def source_language(path):
    if path.name == "Makefile":
        return "hash"
    if path.as_posix() == "scripts/code_stats":
        return "python"
    return _LANGUAGES.get(path.suffix)


def is_test(path):
    return (path.name.endswith("_test.go")
            or bool(set(path.parts[:-1]) & {"reference", "smoke", "tests"})
            or (path.suffix == ".py" and
                (path.name.startswith("test_") or path.name.endswith("_test.py"))))


def collect(root):
    """Return {category: (files, physical lines, code lines)} for tracked sources.

    Git supplies NUL-delimited paths in one fixed-size command, never an argv
    containing every filename. Only one source file is loaded at a time.
    Symlinks and submodules are not followed. Missing tracked sources are errors.
    """
    root = Path(root).resolve()
    listing = subprocess.run(
        ["git", "-C", str(root), "ls-files", "--cached", "--full-name", "-z"],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    ).stdout
    totals = {"production": [0, 0, 0], "tests": [0, 0, 0]}
    for name in sorted(set(listing.split(b"\0")) - {b""}):
        relative = Path(os.fsdecode(name))
        if set(relative.parts) & {".cswd", ".omp"}:
            continue
        language = source_language(relative)
        if language is None:
            continue
        path = root / relative
        # Reject symlinks in any component, not just the final filename.
        if any(parent.is_symlink() for parent in (path, *path.parents)) or path.is_dir():
            continue
        with path.open(encoding="utf-8", errors="surrogateescape") as source:
            physical, code = count_lines(source.read(), language)
        counts = totals["tests" if is_test(relative) else "production"]
        counts[0] += 1
        counts[1] += physical
        counts[2] += code
    return {category: tuple(counts) for category, counts in totals.items()}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("repository", nargs="?", type=Path,
                        default=Path(__file__).resolve().parent.parent,
                        help="repository root (default: this script's repository)")
    args = parser.parse_args(argv)
    try:
        root = subprocess.run(
            ["git", "-C", str(args.repository), "rev-parse", "--show-toplevel"],
            check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        ).stdout
        stats = collect(Path(os.fsdecode(root).rstrip("\n")))
    except (OSError, subprocess.CalledProcessError, tokenize.TokenError, IndentationError) as error:
        parser.exit(1, f"code_stats: {error}\n")
    print("Tracked working-tree source; generated/vendor code included.")
    print("Sources: Go, C/headers, yacc, Python, shell, Makefile; .cswd/.omp excluded.")
    print(f"{'Category':<14} {'Files':>10} {'Total lines':>15} {'Code lines':>15}")
    for label, counts in (*stats.items(), ("overall", tuple(map(sum, zip(*stats.values()))))):
        print(f"{label.capitalize():<14} {counts[0]:>10,} {counts[1]:>15,} {counts[2]:>15,}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
